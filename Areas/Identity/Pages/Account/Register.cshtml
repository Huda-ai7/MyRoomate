@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-4">
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <h1>تسجيل جديد</h1>
            <hr />
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Username" class="form-control" aria-required="true" placeholder="huda-77" />
                <label asp-for="Input.Username">username</label>
                <span asp-validation-for="Input.Username" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <div class="mb-3 text-end">
                <label asp-for="Input.CityId">اختر المدينة</label>
                <select asp-for="Input.CityId" class="form-select" asp-items="@(new SelectList(Model.Cities, "Id", "Name"))">
                    <option value="">اختر المدينة</option>
                </select>
                <span asp-validation-for="Input.CityId" class="text-danger"></span>
            </div>
            <div class="mb-3 text-end">
                <label asp-for="Input.GanderId" >اختر الجنس</label>
                <select asp-for="Input.GanderId" class="form-select" asp-items="@(new SelectList(Model.Ganders, "Id", "Name"))">
                    <option value="">اختر الجنس</option>
                </select>
                <span asp-validation-for="Input.GanderId" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <button id="registerSubmit" type="submit" class="w-100 btn btn-lg btn-primary">Register</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
